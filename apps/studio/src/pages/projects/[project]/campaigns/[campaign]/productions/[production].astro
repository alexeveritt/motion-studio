---
import { formatDurationLabel, formatTimecode, sectionCompleteness } from "@motion-studio/core";
import ArchiveButton from "../../../../../../components/ArchiveButton.tsx";
import AssetLibrary from "../../../../../../components/AssetLibrary.tsx";
import Breadcrumbs from "../../../../../../components/Breadcrumbs.astro";
import CopyPath from "../../../../../../components/CopyPath.tsx";
import MarkdownEditor from "../../../../../../components/MarkdownEditor.tsx";
import NotFound from "../../../../../../components/NotFound.astro";
import ProductionForm from "../../../../../../components/ProductionForm.tsx";
import ProductionPreview from "../../../../../../components/ProductionPreview.tsx";
import PromptTools from "../../../../../../components/PromptTools.tsx";
import PropsForm from "../../../../../../components/PropsForm.tsx";
import RenderPanel from "../../../../../../components/RenderPanel.tsx";
import Tabs from "../../../../../../components/Tabs.astro";
import Base from "../../../../../../layouts/Base.astro";
import { productionTone } from "../../../../../../lib/format.ts";
import { getApprovals, getRenders, refreshRegistry } from "../../../../../../lib/server/studio.ts";
import {
  campaignUrl,
  findCampaign,
  findProduction,
  findProject,
  loadPageContext,
  productionUrl,
  projectUrl,
} from "../../../../../../lib/server/pages.ts";

const { workspace, assets, catalog, profiles, archiveFolder, maxUploadBytes } =
  await loadPageContext();
const project = findProject(catalog, Astro.params.project);
const campaign = findCampaign(project, Astro.params.campaign);
const production = findProduction(campaign, Astro.params.production);

const TABS = [
  { id: "overview", label: "Overview" },
  { id: "preview", label: "Preview" },
  { id: "render", label: "Render" },
  { id: "brief", label: "Brief" },
  { id: "prompt", label: "Prompt" },
  { id: "notes", label: "Notes" },
  { id: "props", label: "Props" },
  { id: "assets", label: "Assets" },
  { id: "files", label: "Files" },
];
const requested = Astro.url.searchParams.get("tab");
const tab = TABS.some((t) => t.id === requested) ? requested! : "overview";
const id = production?.record.id;

const brief = id ? await workspace.readDocument("production", id, "brief") : undefined;
const documentTab =
  id && (tab === "prompt" || tab === "notes" || tab === "props")
    ? await workspace.readDocument("production", id, tab)
    : undefined;
const files = id && tab === "files" ? await workspace.listFiles("production", id) : [];
const propsSchema = id && tab === "props" ? await workspace.readPropsSchema(id) : undefined;
const productionAssets = id && tab === "assets" ? await assets.list("production", id) : undefined;
// Pick up entry files created since startup (for example by Claude Code).
const registry = id && tab === "preview" ? await refreshRegistry() : undefined;
const productionProps =
  id && tab === "preview" ? await workspace.readProductionProps(id) : undefined;
const renders = id && tab === "render" ? await getRenders() : undefined;
const renderHistory =
  id && renders
    ? {
        ...(await renders.history(id)),
        activeRenderId: renders.activeRenderId ?? null,
        approval: await (await getApprovals()).status(id),
      }
    : undefined;
const sections = brief ? sectionCompleteness(brief.content) : [];
const filled = sections.filter((s) => s.filled).length;
const profile = workspace.settings.renderProfiles.find(
  (p) => p.id === production?.record.defaultRenderProfileId,
);
const issues = catalog.issues.filter(
  (issue) => production && issue.path.startsWith(production.path),
);
---

<Base title={production?.record.title ?? "Production not found"}>
  {!project || !campaign || !production ? (
    <NotFound what="Production" />
  ) : (
    <>
      <Breadcrumbs
        items={[
          { label: project.record.name, href: projectUrl(project.record.slug) },
          {
            label: campaign.record.name,
            href: campaignUrl(project.record.slug, campaign.record.slug),
          },
          { label: production.record.title },
        ]}
      />
      <header class="page-header">
        <div>
          <h1>{production.record.title}</h1>
          <p class="muted">
            {production.record.format.width}×{production.record.format.height} ·{" "}
            {production.record.format.fps} fps · {production.record.format.durationInFrames} frames
            (
            {formatDurationLabel(
              production.record.format.durationInFrames,
              production.record.format.fps,
            )}
            ) · poster frame {production.record.posterFrame} (
            {formatTimecode(production.record.posterFrame, production.record.format.fps)})
          </p>
          <CopyPath client:idle path={production.path} />
        </div>
        <div class="header-meta">
          <span class="badge" data-tone={productionTone(production.record.status)}>
            {production.record.status}
          </span>
          <span
            class="badge"
            data-tone={
              issues.some((i) => i.severity === "error") ? "error" : issues.length ? "warn" : "ok"
            }
          >
            {issues.length === 0 ? "Valid" : `${issues.length} issues`}
          </span>
          <span
            class="badge"
            data-tone={sections.length > 0 && filled === sections.length ? "ok" : "warn"}
          >
            Brief {filled}/{sections.length}
          </span>
        </div>
      </header>

      <Tabs
        tabs={TABS}
        active={tab}
        baseUrl={productionUrl(project.record.slug, campaign.record.slug, production.record.slug)}
      />

      {tab === "overview" && (
        <div class="two-column">
          <section class="panel facts">
            <div>
              <h2>Composition</h2>
              <p>
                <code>{production.record.compositionId}</code>
              </p>
              <p class="muted">
                Entry file <code>{production.record.files.entry}</code>. Render it from the Render
                tab. Use the Prompt tab to hand the work to Claude Code.
              </p>
            </div>
            <div>
              <h3>Default render profile</h3>
              <p>
                {profile
                  ? `${profile.name} (CRF ${profile.crf}, scale ${profile.scale ?? 1})`
                  : production.record.defaultRenderProfileId}
              </p>
            </div>
            {production.record.tags.length > 0 && (
              <div>
                <h3>Tags</h3>
                <p>
                  {production.record.tags.map((t) => (
                    <span class="badge">{t}</span>
                  ))}
                </p>
              </div>
            )}
            {issues.length > 0 && (
              <div>
                <h3>Validation</h3>
                <ul>
                  {issues.map((issue) => (
                    <li>
                      <span class="badge" data-tone={issue.severity === "error" ? "error" : "warn"}>
                        {issue.code}
                      </span>{" "}
                      {issue.message}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
          <section class="panel" aria-labelledby="details-heading">
            <h2 id="details-heading">Details</h2>
            <ProductionForm
              client:load
              mode="edit"
              record={production.record}
              profiles={profiles}
            />
            <ArchiveButton
              client:idle
              scope="production"
              id={production.record.id}
              slug={production.record.slug}
              redirectTo={campaignUrl(project.record.slug, campaign.record.slug)}
              archiveFolder={archiveFolder}
            />
          </section>
        </div>
      )}
      {tab === "preview" && registry && productionProps && (
        <>
          <ProductionPreview
            client:only="react"
            productionId={production.record.id}
            compositionId={production.record.compositionId}
            entryPath={`${production.path}/${production.record.files.entry}`}
            format={production.record.format}
            posterFrame={production.record.posterFrame}
            productionProps={productionProps.props}
            propsPath={productionProps.path}
            registered={production.record.compositionId in registry.entries}
            {...(productionProps.error ? { propsError: productionProps.error } : {})}
          />
          <p class="muted trust-note">
            The preview runs the production's source code in this browser tab. Only preview code you
            or your trusted coding agent wrote or reviewed.
          </p>
        </>
      )}
      {tab === "render" && renderHistory && (
        <RenderPanel
          client:load
          productionId={production.record.id}
          productionPath={production.path}
          profiles={profiles}
          defaultProfileId={production.record.defaultRenderProfileId}
          posterFrame={production.record.posterFrame}
          fps={production.record.format.fps}
          lastFrame={production.record.format.durationInFrames - 1}
          initialHistory={renderHistory}
          archiveFolder={archiveFolder}
        />
      )}
      {tab === "brief" && brief && (
        <MarkdownEditor
          client:load
          scope="production"
          id={production.record.id}
          kind="brief"
          label="Production brief"
          initial={brief}
        />
      )}
      {tab === "prompt" && documentTab && (
        <>
          <PromptTools client:load productionId={production.record.id} />
          <MarkdownEditor
            client:load
            scope="production"
            id={production.record.id}
            kind="prompt"
            label="Claude prompt"
            initial={documentTab}
          />
        </>
      )}
      {tab === "notes" && documentTab && (
        <MarkdownEditor
          client:load
          scope="production"
          id={production.record.id}
          kind="notes"
          label="Notes"
          initial={documentTab}
        />
      )}
      {tab === "assets" && productionAssets && (
        <AssetLibrary
          client:load
          scope="production"
          id={production.record.id}
          title="Production assets"
          description="Assets used only by this production. Campaign, project and brand assets are also available to it."
          initial={productionAssets}
          maxUploadBytes={maxUploadBytes}
        />
      )}
      {tab === "props" && documentTab && propsSchema && (
        <>
          <p class="muted">
            Input props for preview and render, merged over the composition's{" "}
            <code>defaultProps</code>. Put production-specific values here (destination URLs, dates,
            copy variants), never in the source.
          </p>
          {propsSchema.schema ? (
            <PropsForm
              client:load
              productionId={production.record.id}
              schema={propsSchema.schema}
              schemaPath={propsSchema.path}
              initial={documentTab}
            />
          ) : propsSchema.exists ? (
            <section class="panel" role="alert">
              <h2>The props schema is invalid</h2>
              <p>
                <code>{propsSchema.path}</code> has problems, so props cannot be checked and
                rendering is blocked until it is fixed. Ask Claude Code to correct it, or edit the
                file.
              </p>
              <ul>
                {propsSchema.issues.map((issue) => (
                  <li>
                    {issue.path && <code>{issue.path}</code>} {issue.message}
                  </li>
                ))}
              </ul>
            </section>
          ) : (
            <section class="panel">
              <h2>No props schema</h2>
              <p class="muted">
                This production has no <code>props.schema.json</code>, so its props are free-form
                and are not checked before rendering. Ask Claude Code to add one alongside the
                composition.
              </p>
            </section>
          )}
          <details class="panel advanced-props" open={!propsSchema.schema}>
            <summary>
              {propsSchema.schema ? "Advanced: edit props.json directly" : "Edit props.json"}
            </summary>
            <MarkdownEditor
              client:load
              scope="production"
              id={production.record.id}
              kind="props"
              label="Props"
              language="json"
              initial={documentTab.exists ? documentTab : { ...documentTab, content: "{}\n" }}
            />
          </details>
        </>
      )}
      {tab === "files" && (
        <section class="panel">
          <h2>Files</h2>
          <p class="muted">
            Repository-relative paths inside this production folder. Render previews are excluded.
          </p>
          <ul class="file-list">
            {files.map((file) => (
              <li>
                <CopyPath client:visible path={file} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}
</Base>
