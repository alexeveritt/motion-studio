{
  "name": "motion-studio",
  "private": true,
  "description": "Local-only workspace for organising, previewing and rendering code-driven motion projects.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @motion-studio/studio dev",
    "dev:fixtures": "MOTION_STUDIO_WORKSPACE=fixtures/workspace/projects pnpm --filter @motion-studio/studio dev",
    "check": "tsc -p tsconfig.json && pnpm -r --workspace-concurrency=1 check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:workspace": "node scripts/validate-workspace.ts",
    "test:e2e": "playwright test",
    "context-packet": "node scripts/context-packet.ts",
    "render": "node scripts/render.ts",
    "poster": "node scripts/poster.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@motion-studio/core": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@motion-studio/motion-runtime": "workspace:*",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  }
}
